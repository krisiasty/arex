      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(\n  label_replace(\n    (1 - arista_bgp_peer_up{job=~\"$job\",switch=~\"$switch\"})\n      * on(job, switch, vrf, peer, asn)\n        (1 - arista_bgp_peer_under_maintenance{job=~\"$job\",switch=~\"$switch\"}),\n    \"address_family\", \"ipv4\", \"peer\", \".*\"\n  )\n  or\n  label_replace(\n    (1 - arista_bgp_evpn_peer_up{job=~\"$job\",switch=~\"$switch\"})\n      * on(job, switch, vrf, peer, asn)\n        (1 - arista_bgp_evpn_peer_under_maintenance{job=~\"$job\",switch=~\"$switch\"}),\n    \"address_family\", \"evpn\", \"peer\", \".*\"\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Routing peers down",
      "type": "stat"
