# Used by GoReleaser only. It builds the binary for each target architecture and
# places it in the Docker build context before calling docker buildx build. For
# local builds use the main Dockerfile instead.
#
# Pinned by digest, and deliberately the same digest as the runtime stage of the
# main Dockerfile: a local build and a released image should not differ in what
# they are built on.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

COPY arex /usr/local/bin/arex
EXPOSE 9100
ENTRYPOINT ["/usr/local/bin/arex"]
CMD ["-config", "/etc/arex/config.json"]
