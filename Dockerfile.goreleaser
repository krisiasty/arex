# Used by GoReleaser only. For local builds use the main Dockerfile instead.
#
# GoReleaser lays the binaries out per platform in the build context, as
# <os>/<arch>/arex, and builds each platform separately with buildx. The COPY
# therefore has to name the platform, which buildx supplies through these
# predefined build args -- they only take effect if declared.
#
# Pinned by digest, and deliberately the same digest as the runtime stage of the
# main Dockerfile: a local build and a released image should not differ in what
# they are built on.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99

ARG TARGETOS
ARG TARGETARCH
COPY ${TARGETOS}/${TARGETARCH}/arex /usr/local/bin/arex
# Inherited from the nonroot base, but stated so it is enforced here rather
# than assumed, and so image scanners can see it.
USER 65532:65532

EXPOSE 9100
ENTRYPOINT ["/usr/local/bin/arex"]
CMD ["-config", "/etc/arex/config.yaml"]
